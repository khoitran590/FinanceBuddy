[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-at-least-32-random-characters"
client_id = "your-auth0-client-id"
client_secret = "your-auth0-client-secret"
server_metadata_url = "https://YOUR_AUTH0_DOMAIN/.well-known/openid-configuration"

[plaid]
client_id = "your-plaid-client-id"
secret = "your-plaid-production-secret"
environment = "production"
country_codes = ["US"]
token_encryption_key = "replace-with-a-separate-stable-random-secret"
# redirect_uri = "https://your-app.example.com"
# webhook_url = "https://api.your-app.example.com/plaid/webhook"
