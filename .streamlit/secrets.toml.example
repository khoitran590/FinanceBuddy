[supabase]
url = "https://YOUR_PROJECT_REF.supabase.co"
publishable_key = "sb_publishable_YOUR_KEY"
public_app_url = "http://localhost:8501"

[plaid]
client_id = "your-plaid-client-id"
secret = "your-plaid-production-secret"
environment = "production"
country_codes = ["US"]
token_encryption_key = "replace-with-a-separate-stable-random-secret"
# OAuth redirects are not supported by the embedded Link UI in this release.
# webhook_url = "https://api.your-app.example.com/plaid/webhook"
