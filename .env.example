# FinanceBuddy uses Plaid Production by default for Trial and live connections.
# Never commit real credentials.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
PUBLIC_APP_URL=http://localhost:8501

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
PLAID_COUNTRY_CODES=US
PLAID_TOKEN_ENCRYPTION_KEY=

# Required only after enabling OAuth institutions and registering the exact URI.
# PLAID_REDIRECT_URI=https://your-app.example.com
# PLAID_WEBHOOK_URL=https://api.your-app.example.com/plaid/webhook
